# ReserveX 边缘层(08 §五)
# Caddy 只做静态托管 + 反向代理,**不做限流**(无内置令牌桶)——限流落服务层(D4-A)。
# 指标由 Prometheus 在容器网内直连 backend:8080/actuator/prometheus 抓取,不经 Caddy。

# ⚠️ 端口:演示映射 8080:80(宿主 8080 → 容器 80),避开 Windows Hyper-V 保留端口区间。
#    生产改回 80 时同步改 docker-compose.yml 的 ports。
:80 {
	root * /srv/frontend

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
	}
	@no_store path /api /api/*
	header @no_store Cache-Control "no-store"

	# 用 handle 互斥块强制路由顺序。⚠️ 不能靠"书写顺序":Caddy 默认指令序里
	# try_files 排在 respond / reverse_proxy 之前,会先把 /actuator/* 与 /api/*
	# 改写成 /index.html,于是下面的拦截与反代全被绕过 —— 红线 #35 形同虚设。
	# handle 块互相排斥(首匹配者胜),顺序即代码顺序。
	@declared_too_large {
		path /api /api/*
		expression {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 1048576
	}
	handle @declared_too_large {
		header Content-Type "application/json; charset=utf-8"
		header X-Request-Id "{http.request.uuid}"
		respond `{"code":"BAD_REQUEST","msg":"请求体过大","data":null,"requestId":"{http.request.uuid}"}` 413
	}

	# 先拒:/actuator/** 一律 404。指标与 env 端点不上公网(红线 #35)
	@actuator path /actuator /actuator/*
	handle @actuator {
		respond 404
	}

	# 再放:/api 与 /api/** 都反代到 backend。
	@api path /api /api/*
	# Unknown/extension methods are unsupported at this edge. Return 501 without
	# a fabricated resource-specific Allow header, while keeping the JSON contract.
	@api_unknown_method {
		path /api /api/*
		not method GET HEAD POST PUT PATCH DELETE OPTIONS
	}
	handle @api_unknown_method {
		header Content-Type "application/json; charset=utf-8"
		header X-Request-Id "{http.request.uuid}"
		respond `{"code":"BAD_REQUEST","msg":"服务器不支持该 HTTP 方法","data":null,"requestId":"{http.request.uuid}"}` 501
	}
	handle @api {
		request_body {
			max_size 1MB
		}
		# backend 只信任来自 edge 网络的 Caddy。丢弃所有客户端可伪造的
		# Forwarded/X-Forwarded-*，再从当前连接重建来源、协议与 Host。
		reverse_proxy backend:8080 {
			transport http {
				dial_timeout 2s
				response_header_timeout 15s
			}
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Ssl
			header_up -X-Forwarded-Prefix
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto {http.request.scheme}
			header_up X-Forwarded-Host {http.request.host}
			@upstream_unavailable status 502
			handle_response @upstream_unavailable {
				header Content-Type "application/json; charset=utf-8"
				header X-Request-Id "{http.request.uuid}"
				respond `{"code":"SERVICE_DEGRADED","msg":"服务暂不可用","data":null,"requestId":"{http.request.uuid}"}` 503
			}
		}
	}

	# 兜底:非文件路径回 index.html(React Router 深链刷新)
	handle {
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd

	# request_body 在反代前拒绝超限请求；把边缘错误也保持为 API 统一 JSON。
	handle_errors {
		@too_large expression {err.status_code} == 413
		header @too_large Content-Type "application/json; charset=utf-8"
		header @too_large X-Request-Id "{http.request.uuid}"
		respond @too_large `{"code":"BAD_REQUEST","msg":"请求体过大","data":null,"requestId":"{http.request.uuid}"}` 413

		@api_failure {
			path /api /api/*
			expression {err.status_code} != 413
		}
		header @api_failure Content-Type "application/json; charset=utf-8"
		header @api_failure X-Request-Id "{http.request.uuid}"
		respond @api_failure `{"code":"SERVICE_DEGRADED","msg":"服务暂不可用","data":null,"requestId":"{http.request.uuid}"}` 503
	}

	log {
		output stdout
		format console
	}
}
