# ============================================================================
# ReserveX 环境变量模板(08 §4.2)
#
# 用法:cp .env.example .env,然后逐项填值。.env 已在 .gitignore 中,不入库。
#
# ⚠️ 未定义的 ${X} 会被 docker compose 静默替换为空串:
#    MYSQL_ROOT_PASSWORD 为空 → MySQL 容器直接拒绝启动,且报错与密钥无关(排查方向全错)。
#    故本文件列出的 12 个变量必须全部有值,一个都不能少。
#
# ⚠️ 四把密钥(AES_KEY / ID_HASH_PEPPER / QR_HMAC_KEY / JWT_SECRET)必须两两不等。
#    应用启动时会断言,相等即 fail-fast 拒绝启动(bootstrap/SecretGuard)。
#    理由:四者的泄露后果、轮换成本、可轮换性全不同,共用一把 = 一处泄露全线失守。
# ============================================================================

# ---- 基础设施口令 ----------------------------------------------------------
# MySQL root 口令。轮换时先修改库内 root 口令,再同步此值并重启相关服务;禁止删除业务卷
MYSQL_ROOT_PASSWORD=
# 后端应用账号口令。只授予三个业务库的 SELECT/INSERT/UPDATE/DELETE
MYSQL_APP_PASSWORD=
# Redis requirepass。改后重启 redis + backend
REDIS_PASSWORD=
# RocketMQ 应用/管理密钥。生成:openssl rand -hex 32;两者必须不同
ROCKETMQ_APP_SECRET_KEY=
ROCKETMQ_ADMIN_SECRET_KEY=

# Snowflake worker 位。生产多实例必须每个实例显式使用不同的 0..31 值。
WORKER_ID=0

# ---- 本地开发机资源覆盖(可选)---------------------------------------------
# 仅在 16GB 等内存紧张的开发机取消注释；生产继续使用容器内存限制 + MaxRAMPercentage。
# BACKEND_JAVA_TOOL_OPTIONS=-Xms128m -Xmx1024m -XX:+ExitOnOutOfMemoryError
# ROCKETMQ_HEAP_OPTS=-Xms256m -Xmx256m -Xmn128m -XX:MaxDirectMemorySize=256m
# ROCKETMQ_NAMESRV_HEAP_OPTS=-Xms192m -Xmx192m -Xmn96m

# ---- 四把密钥(两两不等)---------------------------------------------------
# id_card_ciphertext 的 AES-256-GCM 密钥:必须 32 字节,base64 后 44 字符
#   生成:openssl rand -base64 32
#   ✅ 可轮换:加 aes-v2 + 改 reservex.aes.key-id,旧行按 id_card_key_id 继续可解
AES_KEY=
# id_card_hash 的全局 pepper:≥32 字节随机
#   生成:openssl rand -base64 48
#   ❌ 不可轮换:它进了 id_card_route 的主键,换了等于配额历史全失效(03 §2.1 已认下)
ID_HASH_PEPPER=
# QR 载荷 HMAC-SHA256 密钥:≥32 字节随机
#   生成:openssl rand -base64 48
#   ✅ 可轮换且成本为零:reservex.qr.accepted-key-ids 双 key 并存
QR_HMAC_KEY=
# Sa-Token JWT 签名密钥:≥32 字节随机
#   生成:openssl rand -base64 48
#   ✅ 可轮换,但轮换即全员掉线(存量 access 无法验签),提前公告即可
JWT_SECRET=

# ---- 外部服务 --------------------------------------------------------------
# QQ 邮箱 SMTP 授权码(非登录密码),由邮箱服务商生成
QQ_SMTP_PASSWORD=

# ---- 超管引导(08 §4.1)---------------------------------------------------
# 超管首登密码。02-seed.sql 只写哨兵值 '!',真正的 BCrypt 由应用启动时用这个变量算出并写入。
# ⚠️ 这个值团队可见 → 首次登录后必须立刻改密(force-change-on-first-login: true)
ADMIN_INIT_PASSWORD=
