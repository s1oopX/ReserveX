{
  "name": "reservex-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:auth": "node --experimental-strip-types --test scripts/auth-session.test.mjs",
    "test:http": "node --test scripts/http-timeout.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.446.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "2.5.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "7.3.6"
  }
}
