<?xml version="1.0" encoding="UTF-8"?>
<!--
  ReserveX backend —— 单进程模块化单体(08 §二 D8)
  api / worker / reconciler 三个逻辑模块同 jar、同 @SpringBootApplication,
  靠包边界隔离;v2 拆独立进程只改部署不改代码。

  ⚠️ 版本全部**显式钉死**,不用 LATEST/RELEASE:
     ShardingSphere / MyBatis-Plus / Sa-Token 三者对 Spring Boot 3 的适配都挑版本,
     浮动版本会在某次 mvn -U 后突然起不来,且报错指向 Bean 装配而非版本。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.reservex</groupId>
  <artifactId>reservex-backend</artifactId>
  <version>1.0.0</version>
  <name>reservex-backend</name>
  <description>湿地公园预约系统 —— 抢号只动 Redis + 普通消息 + 补偿 + 对账(Q1-B)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <mybatis-plus.version>3.5.9</mybatis-plus.version>
    <shardingsphere.version>5.5.2</shardingsphere.version>
    <sa-token.version>1.45.0</sa-token.version>
    <redisson.version>3.52.0</redisson.version>
    <rocketmq-spring.version>2.3.6</rocketmq-spring.version>
    <rocketmq-client.version>5.5.0</rocketmq-client.version>
    <hutool.version>5.8.47</hutool.version>
    <jackson-bom.version>2.21.5</jackson-bom.version>
    <netty.version>4.1.137.Final</netty.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <log4j2.version>2.25.5</log4j2.version>
    <httpclient5.version>5.6.3</httpclient5.version>
    <httpcore5.version>5.4.3</httpcore5.version>
    <opentelemetry.version>1.62.0</opentelemetry.version>
    <opentelemetry-alpha.version>1.62.0-alpha</opentelemetry-alpha.version>
    <grpc.version>1.75.0</grpc.version>
    <calcite.version>1.42.0</calcite.version>
    <lz4.version>1.11.1</lz4.version>
    <guava.version>33.3.1-jre</guava.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <easy-captcha.version>1.6.2</easy-captcha.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom-alpha</artifactId>
        <version>${opentelemetry-alpha.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ==================== Web / 校验 / 观测 ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- /actuator/prometheus 零代码暴露(08 §6.0)。Caddy 已把 /actuator/* 挡在公网外 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- ==================== 数据层 ==================== -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 分库分表:只覆盖 user / reservation 两张绑定表;单库表走独立 DataSource(03 §1.1) -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-jdbc</artifactId>
      <version>${shardingsphere.version}</version>
      <exclusions>
        <!-- ShardingSphere 自带 logback-classic,与 Boot 的版本打架 -->
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- 5.5.3 的 JDBC 聚合包不再把分片特性带入运行时。 -->
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-sharding-core</artifactId>
      <version>${shardingsphere.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-infra-data-source-pool-hikari</artifactId>
      <version>${shardingsphere.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-standalone-mode-core</artifactId>
      <version>${shardingsphere.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-standalone-mode-repository-jdbc</artifactId>
      <version>${shardingsphere.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.shardingsphere</groupId>
      <artifactId>shardingsphere-authority-simple</artifactId>
      <version>${shardingsphere.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.calcite</groupId>
      <artifactId>calcite-core</artifactId>
      <version>${calcite.version}</version>
    </dependency>

    <!-- ==================== 缓存 / 锁 / 限流 ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- 分布式锁选主 + RRateLimiter + 单飞重建锁 -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
      <version>${redisson.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-data-redis</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- 本地限流第一层(D4-A):RateLimiter.create -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>${guava.version}</version>
    </dependency>

    <!-- ==================== 消息 ==================== -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-spring-boot-starter</artifactId>
      <version>${rocketmq-spring.version}</version>
      <exclusions>
        <!-- 5.5 client already contains the client-side ACL hook used by the starter. -->
        <exclusion>
          <groupId>org.apache.rocketmq</groupId>
          <artifactId>rocketmq-acl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Spring starter lags the broker/client line; direct versions win Maven mediation. -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
      <version>${rocketmq-client.version}</version>
      <exclusions>
        <exclusion>
          <groupId>io.github.aliyunmq</groupId>
          <artifactId>rocketmq-logback-classic</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Route RocketMQ's shaded SLF4J API into Boot's Logback; do not ship the vulnerable shaded Logback fork. -->
    <dependency>
      <groupId>io.github.aliyunmq</groupId>
      <artifactId>rocketmq-slf4j-api-bridge</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>at.yawk.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>${lz4.version}</version>
    </dependency>
    <!-- RocketMQ 5.5 still calls Fastjson 1.x APIs; use its no-auto-type build. -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>fastjson</artifactId>
      <version>1.2.83_noneautotype</version>
    </dependency>

    <!-- ==================== 鉴权 ==================== -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-spring-boot3-starter</artifactId>
      <version>${sa-token.version}</version>
    </dependency>
    <!-- Simple JWT 的 token 映射保存在 Redis，支持注销、改密和封禁时即时撤销。 -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-jwt</artifactId>
      <version>${sa-token.version}</version>
      <exclusions>
        <exclusion>
          <groupId>cn.hutool</groupId>
          <artifactId>hutool-jwt</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- refresh 白名单存 Redis(要能主动失效:注销/封禁/改密) -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-redis-jackson</artifactId>
      <version>${sa-token.version}</version>
    </dependency>

    <!-- ==================== 稳定性 ==================== -->
    <!-- 熔断:只熔界外调用(SMTP)。核心链路(Lua/DB CAS)是本地操作不该熔(08 §6.2) -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot3</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- ==================== 工具 ==================== -->
    <!-- Snowflake / BCrypt / AES-GCM / SHA256 / 脱敏 -->
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
      <version>${hutool.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- 风控触发图形验证码;滑块(AJ-Captcha)更防 OCR 但重,v1 不取 -->
    <dependency>
      <groupId>com.github.whvcse</groupId>
      <artifactId>easy-captcha</artifactId>
      <version>${easy-captcha.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ==================== 测试 ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>reservex-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
