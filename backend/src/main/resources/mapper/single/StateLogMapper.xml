<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.reservex.mapper.single.StateLogMapper">

    <resultMap id="BaseResultMap" type="com.reservex.entity.StateLog">
        <id     property="xid"      column="xid"/>
        <result property="branchId" column="branch_id"/>
        <result property="status"   column="status"/>
        <result property="createAt" column="create_at"/>
        <result property="updateAt" column="update_at"/>
    </resultMap>

    <!--
      ① Try(消费者落库前)。PK 冲突说明已 Try 过(消息重投)→ 0 行,幂等跳过。
      ⚠️ 时间用 NOW():state_log 是纯技术日志,不参与任何业务时间判据,
         故此处容器时区偏差不会造成业务错误。业务时间字段一律传参(见 SlotMapper)。
    -->
    <insert id="insertTry">
        INSERT IGNORE INTO `state_log` (`xid`, `branch_id`, `status`, `create_at`, `update_at`)
        VALUES (#{xid}, #{branchId}, 1, NOW(), NOW())
    </insert>

    <!-- ② Confirm(核销 CAS 成功后)。reservation 的 CAS 是业务真值；
         窗口期取消可能在 CAS 后、此更新前写入 Cancel，因此 Confirm 必须能收口 1/3。 -->
    <update id="confirm">
        UPDATE `state_log`
        SET `status`    = 2,
            `update_at` = NOW()
        WHERE `xid`    = #{xid}
          AND `status` IN (1, 3)
    </update>

    <!-- ③ Cancel(取消/超时/10.2a 回滚)。
         status IN (0,1):已 Confirm(2)的不能再 Cancel —— 核销过的预约不可回滚;
         已 Cancel(3)的重复执行 0 行,幂等。与 03 §6.1 表格逐字一致 -->
    <update id="cancel">
        UPDATE `state_log`
        SET `status`    = 3,
            `update_at` = NOW()
        WHERE `xid`     = #{xid}
          AND `status` IN (0, 1)
    </update>

    <!--
      ④ 空回滚占位:回滚先到、Try 还没写(消息乱序)。
      不插会导致**悬挂**:随后姗姗来迟的 Try 看不到任何回滚痕迹,会照常落库,
      造出一笔"已被回滚却仍存在"的预约,而 Redis 余量已回补 → 超卖。
      ⚠️ 所以 Try 之后必须回读 status:见到 3 就把本次落库转 CANCELLED。
    -->
    <insert id="insertOrCancel">
        INSERT INTO `state_log` (`xid`, `branch_id`, `status`, `create_at`, `update_at`)
        VALUES (#{xid}, #{branchId}, 3, NOW(), NOW())
        ON DUPLICATE KEY UPDATE
            `status` = IF(`status` IN (2, 4), `status`, 3),
            `update_at` = NOW()
    </insert>

    <!-- Lua 已回补后的专用收口。取消/过期不得覆盖 status=4。 -->
    <update id="completeRollback">
        UPDATE `state_log`
        SET `status` = 3, `update_at` = NOW()
        WHERE `xid` = #{xid} AND `status` = 4
    </update>

    <update id="promoteRollbackClaim">
        UPDATE `state_log`
        SET `status` = 4, `update_at` = NOW()
        WHERE `xid` = #{xid} AND `status` = 3
    </update>

    <!-- 人工回滚与 persistence-consumer 的单库仲裁点。PK 已存在时不覆盖任何终态。 -->
    <insert id="insertRollbackClaim">
        INSERT IGNORE INTO `state_log` (`xid`, `branch_id`, `status`, `create_at`, `update_at`)
        VALUES (#{xid}, #{branchId}, 4, NOW(), NOW())
    </insert>

</mapper>
