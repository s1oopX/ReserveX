<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.reservex.mapper.single.IdCardIdentityMapper">

    <resultMap id="BaseResultMap" type="com.reservex.entity.IdCardIdentity">
        <id property="idCardHash" column="id_card_hash"/>
        <result property="userId" column="user_id"/>
        <result property="createAt" column="create_at"/>
    </resultMap>

    <insert id="insertIgnore">
        INSERT IGNORE INTO `id_card_identity` (`id_card_hash`, `user_id`, `create_at`)
        VALUES (#{idCardHash}, #{userId}, #{createAt})
    </insert>

    <delete id="deleteByHashAndUser">
        DELETE FROM `id_card_identity`
        WHERE `id_card_hash` = #{idCardHash}
          AND `user_id` = #{userId}
    </delete>

    <select id="selectOrphansOlderThan" resultMap="BaseResultMap">
        SELECT `id_card_hash`, `user_id`, `create_at`
        FROM `id_card_identity`
        WHERE `create_at` &lt; #{cutoff}
        <if test="afterCreateAt != null">
          AND (`create_at` &gt; #{afterCreateAt}
               OR (`create_at` = #{afterCreateAt} AND `id_card_hash` &gt; #{afterIdCardHash}))
        </if>
        ORDER BY `create_at`, `id_card_hash`
        LIMIT #{limit}
    </select>

</mapper>
