<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 单库表(reservex_single),走 singleDataSource + singleTxManager -->
<mapper namespace="com.reservex.mapper.single.EmailRouteMapper">

    <resultMap id="BaseResultMap" type="com.reservex.entity.EmailRoute">
        <id     property="email"    column="email"/>
        <result property="userId"   column="user_id"/>
        <result property="createAt" column="create_at"/>
    </resultMap>

    <!--
      注册第一步:抢邮箱唯一性。
      ⚠️ 必须是 INSERT IGNORE,不能"先 select 再 insert" ——
         并发下两个请求都能通过检查,唯一性只能靠写入本身保证。
    -->
    <insert id="insertIgnore">
        INSERT IGNORE INTO `email_route` (`email`, `user_id`, `create_at`)
        VALUES (#{email}, #{userId}, #{createAt})
    </insert>

    <!-- 补偿删除,条件带 user_id(同 EmailRouteMapper 的理由) -->
    <delete id="deleteByEmailAndUser">
        DELETE FROM `email_route`
        WHERE `email`   = #{email}
          AND `user_id` = #{userId}
    </delete>

    <!--
      孤儿 route 清理扫描。create_at 早于 cutoff 的 route 可能对应从未成功写入的 user 行。
      min-age 守卫由调用方算 cutoff 时减去,这里只做纯时间过滤。
    -->
    <select id="selectOrphansOlderThan" resultMap="BaseResultMap">
        SELECT `email`, `user_id`, `create_at`
        FROM `email_route`
        WHERE `create_at` &lt; #{cutoff}
        <if test="afterCreateAt != null">
          AND (`create_at` &gt; #{afterCreateAt}
               OR (`create_at` = #{afterCreateAt} AND `email` &gt; #{afterEmail}))
        </if>
        ORDER BY `create_at`, `email`
        LIMIT #{limit}
    </select>

</mapper>
